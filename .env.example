# ---- runtime ----
MEDX_ENVIRONMENT=local
MEDX_LOG_LEVEL=INFO
MEDX_API_KEY=your_value_here

# ---- OCR: auto | textract | tesseract ----
MEDX_OCR_PROVIDER=auto
MEDX_OCR_MIN_CONFIDENCE=0.80

# ---- LLM: rules (offline) | bedrock | anthropic ----
MEDX_LLM_PROVIDER=rules
MEDX_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# MEDX_ANTHROPIC_API_KEY=sk-ant-...      # only with a BAA / ZDR agreement for PHI
# MEDX_ANTHROPIC_MODEL=claude-sonnet-4-5
MEDX_LLM_MAX_RETRIES=2

# ---- quality gates ----
MEDX_AUTO_APPROVE_THRESHOLD=0.90
MEDX_FIELD_REVIEW_THRESHOLD=0.75

# ---- AWS (leave blank for local in-memory/file storage) ----
MEDX_AWS_REGION=us-east-1
# MEDX_S3_BUCKET=
# MEDX_KMS_KEY_ID=
# MEDX_SQS_QUEUE_URL=
# MEDX_STORAGE_BACKEND=dynamodb
# MEDX_DYNAMODB_TABLE=
